{
  "name": "monkmail",
  "version": "1.0.5",
  "description": "monkmail",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "concurrently -n \"API,WRK\" -c \"cyan,magenta\" \"ts-node src/api.ts\" \"ts-node src/worker.ts\"",
    "dev:api": "ts-node src/api.ts",
    "dev:worker": "ts-node src/worker.ts",
    "start": "npm run build && concurrently -n \"API,WRK\" -c \"cyan,magenta\" \"node dist/api.js\" \"node dist/worker.js\"",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "test:webhook": "ts-node test/webhook.ts"
  },
  "keywords": [
    "telegram",
    "github",
    "webhook",
    "queue",
    "bullmq"
  ],
  "author": "Jay",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/node": "^24.10.1",
    "axios": "^1.13.4",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "bullmq": "^5.67.3",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "ioredis": "^5.9.2"
  }
}